# Flashcards OS 2030 — Mega Final Operational Truth
# Server-side only. Never expose secrets to NEXT_PUBLIC_* variables.

# Explicit demo mode. Keep false/absent in production.
FLASHCARDS_OS_DEMO_MODE=false

# Sovereign Windows Vault Node
FLASHCARDS_OS_WINDOWS_NODE_URL=http://YOUR-WINDOWS-HOST:8787
FLASHCARDS_OS_WINDOWS_NODE_ID=flashcards-vault-primary
FLASHCARDS_OS_WINDOWS_NODE_SECRET=YOUR_PRODUCTION_RANDOM_SECRET
FLASHCARDS_OS_WINDOWS_NODE_TIMEOUT_MS=30000
FLASHCARDS_OS_UPLOAD_CHUNK_SIZE=8388608
FLASHCARDS_OS_UPLOAD_SESSION_TTL_HOURS=48
FLASHCARDS_OS_MAX_SOURCE_FILE_SIZE=5368709120
FLASHCARDS_OS_MAX_VIDEO_FILE_SIZE=8589934592
