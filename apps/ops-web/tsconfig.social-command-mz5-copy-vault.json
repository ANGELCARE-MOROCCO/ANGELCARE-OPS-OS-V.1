{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "lib/social-command/copy-vault-types.ts",
    "lib/social-command/copy-vault.ts",
    "app/api/social-command/copy-vault/[...segments]/route.ts",
    "app/(protected)/social-command/_components/CopyVaultPicker.tsx",
    "app/(protected)/social-command/_components/CopyVaultWorkspace.tsx",
    "app/(protected)/social-command/_components/SocialCommandClient.tsx",
    "app/(protected)/social-command/_components/BulkOrchestrator.tsx",
    "app/(protected)/social-command/_components/EngagementCommand.tsx"
  ],
  "exclude": ["node_modules", ".next", ".angelcare_backups", "backups", "_archive"]
}
