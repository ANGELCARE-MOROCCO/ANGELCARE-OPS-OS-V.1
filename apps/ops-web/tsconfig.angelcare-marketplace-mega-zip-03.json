{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "angelcare-marketplace/domain/types.ts",
    "angelcare-marketplace/permissions/permission-catalog.ts",
    "angelcare-marketplace/localization-intelligence/**/*.ts",
    "angelcare-marketplace/localization-intelligence/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/localization/**/*.ts",
    "app/angelcare-marketplace/(protected)/admin/localization/**/*.tsx",
    "app/api/angelcare-marketplace/localization/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
