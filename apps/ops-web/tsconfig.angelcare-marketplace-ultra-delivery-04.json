{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "angelcare-marketplace/css-modules.d.ts",
    "angelcare-marketplace/domain/types.ts",
    "angelcare-marketplace/permissions/permission-catalog.ts",
    "angelcare-marketplace/shells/AdminNavigation.tsx",
    "angelcare-marketplace/academy-engine/**/*.ts",
    "angelcare-marketplace/academy-engine/**/*.tsx",
    "angelcare-marketplace/provider-workforce/**/*.ts",
    "angelcare-marketplace/provider-workforce/**/*.tsx",
    "angelcare-marketplace/operations-execution/**/*.ts",
    "angelcare-marketplace/operations-execution/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/academy/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/providers/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/operations/**/*.tsx",
    "app/angelcare-marketplace/(provider)/provider/**/*.tsx",
    "app/angelcare-marketplace/(trainer)/trainer/**/*.tsx",
    "app/angelcare-marketplace/[locale]/academy/**/*.tsx",
    "app/api/angelcare-marketplace/academy/**/*.ts",
    "app/api/angelcare-marketplace/providers/**/*.ts",
    "app/api/angelcare-marketplace/operations/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
