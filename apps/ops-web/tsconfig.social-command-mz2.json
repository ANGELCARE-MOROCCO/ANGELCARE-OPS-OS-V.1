{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "app/(protected)/social-command/**/*.ts",
    "app/(protected)/social-command/**/*.tsx",
    "app/api/social-command/**/*.ts",
    "lib/social-command/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".angelcare_backups", "backups", "_archive"]
}
