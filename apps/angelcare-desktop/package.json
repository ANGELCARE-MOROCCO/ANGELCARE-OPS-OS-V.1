{
  "name": "@angelcare/desktop",
  "productName": "ANGELCARE Desktop",
  "version": "1.7.3",
  "description": "ANGELCARE Desktop Corporate Station OS 1.7.3 \u2014 unified Windows/macOS executive runtime where Corporate Locked security remains compatible with explicitly authorized AC+ workspaces and split operations, with dormant WhatsApp activation, clean device re-enrolment, session isolation and hardened native packaging.",
  "author": "ANGELCARE",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:dev": "cross-env NODE_ENV=development ANGELCARE_DESKTOP_APP_URL=http://localhost:3000 electron-forge start",
    "start:production-preview": "cross-env NODE_ENV=production electron-forge start",
    "verify": "node scripts/verify-unified-release-1.7.3.mjs",
    "verify:cumulative": "npm run verify",
    "verify:security": "node scripts/smoke-runtime-security.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:config": "node scripts/smoke-config.mjs",
    "package": "npm run verify && electron-forge package",
    "make": "npm run verify && electron-forge make",
    "package:mac:x64": "npm run verify && node scripts/build-macos-dmg.mjs x64",
    "package:mac:arm64": "npm run verify && node scripts/build-macos-dmg.mjs arm64",
    "package:mac": "node scripts/package-platform.mjs mac",
    "package:windows": "npm run verify && node scripts/build-windows-installer.mjs x64",
    "package:all": "node scripts/package-platform.mjs all",
    "make:mac:x64": "npm run verify && node scripts/build-macos-dmg.mjs x64",
    "make:mac:arm64": "npm run verify && node scripts/build-macos-dmg.mjs arm64",
    "make:mac:zip:x64": "npm run verify && electron-forge make --platform=darwin --arch=x64",
    "make:mac:zip:arm64": "npm run verify && electron-forge make --platform=darwin --arch=arm64",
    "make:win:x64": "npm run verify && node scripts/build-windows-installer.mjs x64",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "signing:preflight": "node scripts/preflight-signing.mjs",
    "clean": "node scripts/clean-output.mjs",
    "verify:mac-toolbar": "node scripts/verify-mac-horizontal-menu.mjs",
    "verify:mz9": "node scripts/verify-mega-zip-9.mjs",
    "verify:mz11": "node scripts/verify-unified-release-1.7.3.mjs",
    "release:bundle": "node scripts/assemble-release-bundle.mjs",
    "verify:mz12": "node scripts/verify-unified-release-1.7.3.mjs",
    "verify:mz13": "node scripts/verify-unified-release-1.7.3.mjs",
    "verify:mz15": "node scripts/verify-unified-release-1.7.3.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "cross-env": "7.0.3",
    "electron": "43.1.1"
  }
}
