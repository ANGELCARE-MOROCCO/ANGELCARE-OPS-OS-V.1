# SANILA Marketing Director AI — copy only the required values into apps/ops-web/.env.local
MARKETING_AI_ENABLED=true
GEMINI_API_KEY=YOUR_SECRET
# Existing Revenue Command OS model variables are reused when these are omitted.
MARKETING_AI_PRIMARY_MODEL=gemini-3.6-flash
MARKETING_AI_FALLBACK_MODEL=gemini-3.5-flash-lite
MARKETING_AI_SEARCH_GROUNDING_ENABLED=true
MARKETING_AI_CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
MARKETING_AI_MAX_OUTPUT_TOKENS=8192
MARKETING_AI_MAX_COMMANDS_PER_MISSION=12
MARKETING_AI_MAX_DUE_RUNS_PER_BATCH=8
MARKETING_AI_MAX_RUNS_PER_HOUR=30
MARKETING_AI_MAX_TOKENS_PER_DAY=500000
MARKETING_AI_TIMEOUT_MS=120000
MARKETING_AI_DETERMINISTIC_FALLBACK_ENABLED=false
MARKETING_AI_MONTHLY_RESOURCE_DOMAINS=ai.google.dev,thinkwithgoogle.com,developers.google.com/search,facebook.com/business,linkedin.com/business,tiktok.com/business

# Reuse the existing Email OS Windows bridge. Do not create a second bridge.
MARKETING_AI_BRIDGE_STORAGE_ENABLED=true
MARKETING_AI_BRIDGE_MODULE_KEY=market_os_content_command
EMAIL_OS_STORAGE_BRIDGE_URL=https://YOUR_EXISTING_WINDOWS_BRIDGE
EMAIL_BRIDGE_ADMIN_TOKEN=YOUR_EXISTING_SECRET
