{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "angelcare-marketplace/css-modules.d.ts",
    "angelcare-marketplace/domain/types.ts",
    "angelcare-marketplace/permissions/permission-catalog.ts",
    "angelcare-marketplace/shells/AdminNavigation.tsx",
    "angelcare-marketplace/trust-quality/**/*.ts",
    "angelcare-marketplace/trust-quality/**/*.tsx",
    "angelcare-marketplace/finance-authority/**/*.ts",
    "angelcare-marketplace/finance-authority/**/*.tsx",
    "angelcare-marketplace/analytics-security/**/*.ts",
    "angelcare-marketplace/analytics-security/**/*.tsx",
    "angelcare-marketplace/launch-assurance/**/*.ts",
    "angelcare-marketplace/launch-assurance/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/trust/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/finance/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/analytics/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/security/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/quality-assurance/**/*.tsx",
    "app/angelcare-marketplace/(protected)/admin/launch/**/*.tsx",
    "app/angelcare-marketplace/[locale]/trust/**/*.tsx",
    "app/api/angelcare-marketplace/trust/**/*.ts",
    "app/api/angelcare-marketplace/finance/**/*.ts",
    "app/api/angelcare-marketplace/analytics/**/*.ts",
    "app/api/angelcare-marketplace/security/**/*.ts",
    "app/api/angelcare-marketplace/qa/**/*.ts",
    "app/api/angelcare-marketplace/launch/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
