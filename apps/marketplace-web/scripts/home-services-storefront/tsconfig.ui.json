{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "react"
    ],
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "css.d.ts",
    "../../angelcare-marketplace/home-services-storefront/**/*.tsx",
    "../../angelcare-marketplace/home-services-storefront/experience.ts"
  ]
}