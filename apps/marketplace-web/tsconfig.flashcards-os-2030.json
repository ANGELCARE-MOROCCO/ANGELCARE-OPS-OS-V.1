{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "app/(protected)/flashcards-os/**/*.ts",
    "app/(protected)/flashcards-os/**/*.tsx",
    "app/api/flashcards-os/**/*.ts",
    "components/flashcards-os/**/*.ts",
    "components/flashcards-os/**/*.tsx",
    "lib/flashcards-os/**/*.ts",
    "lib/getUser.ts",
    "lib/auth/session.ts",
    "lib/supabase/env.ts",
    "lib/supabase/server.ts",
    "types/**/*.d.ts"
  ]
}
