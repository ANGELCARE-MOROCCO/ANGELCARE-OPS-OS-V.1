  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "angelcare-marketplace/sanila-world/**/*.ts",
    "angelcare-marketplace/sanila-world/**/*.tsx",
    "angelcare-marketplace/sanila-studio/**/*.tsx",
    "angelcare-marketplace/sanila-admin/types.ts",
