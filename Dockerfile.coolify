# syntax=docker/dockerfile:1.7

FROM node:24-bookworm AS deps

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY apps/marketplace-web/package*.json ./

RUN if [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi


FROM node:24-bookworm AS builder

WORKDIR /repo

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY . .

COPY --from=deps /app/node_modules /repo/apps/marketplace-web/node_modules

WORKDIR /repo/apps/marketplace-web

RUN mkdir -p public

RUN --mount=type=secret,id=envfile,target=/repo/apps/marketplace-web/.env.production.local,required=false \
    npm run build

RUN npm prune --omit=dev


FROM node:24-bookworm-slim AS runner

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder --chown=node:node \
  /repo/apps/marketplace-web \
  /app

USER node

EXPOSE 3000

HEALTHCHECK \
  --interval=30s \
  --timeout=8s \
  --start-period=60s \
  --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health/ready').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"

CMD ["./node_modules/.bin/next","start","-H","0.0.0.0","-p","3000"]
